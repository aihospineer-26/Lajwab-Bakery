# Supabase project the app talks to. Leave unset to run fully on local data.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Forces on-device codes regardless of channel. Also the automatic fallback
# whenever the Supabase URL above is unset.
EXPO_PUBLIC_OTP_MODE=demo

# How the code reaches the customer. Screens are identical either way.
#   whatsapp  Supabase mints the code, the Send SMS Hook delivers it (default)
#             -> WHATSAPP_OTP.md
#   firebase  Firebase sends real SMS with no DLT registration needed
#             -> FIREBASE_OTP.md   (needs a dev build, not Expo Go)
#   demo      shown on screen
EXPO_PUBLIC_OTP_CHANNEL=whatsapp

# Set to `inventory` to boot the staff app (AppInventory.tsx) instead.
EXPO_PUBLIC_APP_TARGET=

# Firebase web config — only needed when EXPO_PUBLIC_OTP_CHANNEL=firebase and
# you are deploying the website. Native (the APK) reads google-services.json
# instead and ignores these. All four are public identifiers, not secrets:
# they ship inside every client. Copy them from
#   Firebase console → Project settings → Your apps → Web app → SDK setup.
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=
