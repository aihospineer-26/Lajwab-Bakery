# Supabase project the app talks to. Leave unset to run fully on local data.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Phone OTP delivery. Set to `demo` to generate and show the code on-device
# instead of sending it over WhatsApp. Defaults to demo whenever the Supabase
# URL above is unset. See WHATSAPP_OTP.md for the live setup.
EXPO_PUBLIC_OTP_MODE=demo

# Set to `inventory` to boot the staff app (AppInventory.tsx) instead.
EXPO_PUBLIC_APP_TARGET=
