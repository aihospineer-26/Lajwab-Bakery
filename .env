# Build-time configuration for the shipped app.
#
# This file is committed on purpose. EAS Build uploads the project honouring
# .gitignore, and .env.local is ignored -- so without this file an APK builds
# with no Supabase URL, no key and no MSG91 widget: it installs, opens to an
# empty catalogue, and sign-in does nothing. That failure looks like a code
# fault and is not one.
#
# Every value here is EXPO_PUBLIC_*, which Expo inlines into the JavaScript
# bundle. They are already readable in the shipped web build and in any APK, so
# committing them exposes nothing that shipping the app does not. Real secrets
# -- the Supabase service-role key, the MSG91 account authkey -- are set as
# Edge Function secrets and appear in no client build.
#
# .env.local still wins locally, so day-to-day development is unaffected.
#
# The Firebase values are inert while the OTP channel is msg91. They are kept
# so switching channels is a one-line change rather than a scavenger hunt;
# native Firebase also needs google-services.json before it will link.

EXPO_PUBLIC_SUPABASE_URL=https://hshxnghtduybgkvtezxu.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_EQJd2nArB_f34_00oZBBQg_VBbn0IVG
EXPO_PUBLIC_OTP_CHANNEL=msg91
EXPO_PUBLIC_MSG91_WIDGET_ID=36687a6b7172353336353337
EXPO_PUBLIC_MSG91_AUTH_TOKEN=564634TZ6g7UzblH5i6a8ecbd3P1
EXPO_PUBLIC_FIREBASE_API_KEY=AIzaSyDgapP0XWb34cTGQkxBxy_RkDFjY9TgTJQ
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=lajwab-bakery.firebaseapp.com
EXPO_PUBLIC_FIREBASE_PROJECT_ID=lajwab-bakery
EXPO_PUBLIC_FIREBASE_APP_ID=1:129182362676:web:3f6229ef74ae9b8cdeae61
